  "design_method": {
    "id": "html-design-method",
    "visual_checkpoint": {
      "default": "disabled",
      "enable_when": [
        "使用者明確要求探索視覺方向",
        "尚未選定 Theme，且不同方向會明顯改變閱讀方式"
      ],
      "preview_count": 3,
      "rule": "只預覽視覺方向，不先生成完整簡報，也不作為每次生成的必經步驟。"
    },
    "deck_review": {
      "format": "keep-fix-quick-win",
      "questions": [
        {
          "id": "repeated-skeleton",
          "question": "連續頁是否重複同一個骨架，或只換顏色與裝飾？",
          "machine_check": true
        },
        {
          "id": "page-rhythm",
          "question": "Hero、內容頁、資料頁與停頓頁的節奏是否有變化？",
          "machine_check": true
        },
        {
          "id": "signature-fit",
          "question": "每頁的招牌構圖是否真的符合內容關係？",
          "machine_check": true
        },
        {
          "id": "type-capacity-fit",
          "question": "當頁 composition 是否保留 primary items，而且在正式字體下達到 36px 並完整容納？",
          "machine_check": true
        },
        {
          "id": "unintended-collision",
          "question": "是否存在文字重疊、文字碰撞物件、線條穿字、裁切或 overflow？",
          "machine_check": true
        },
        {
          "id": "layout-only-edit-hit",
          "question": "Content Area 與排版 slot 是否完全不會成為編輯選取物件？",
          "machine_check": true
        },
        {
          "id": "nested-group-preservation",
          "question": "取消外層手動群組後，內層 semantic module 是否仍保持完整？",
          "machine_check": true
        },
        {
          "id": "body-field-balance",
          "question": "沒有 counterweight 的多模組頁是否使用至少 68% 的 Content Area 可見寬度？",
          "machine_check": true
        },
        {
          "id": "palette-jarring",
          "question": "配色是否突兀？",
          "machine_check": false
        }
      ]
    },
    "deferred": [
      "presenter-workspace",
      "object-comment-to-ai"
    ],
    "forbidden": [
      "webgl",
      "copied-third-party-code",
      "copied-third-party-template",
      "unlicensed-or-unattributed-third-party-assets",
      "decorative-photo-or-illustration",
      "decorative-svg-or-icon-pack",
      "screenshot-as-slide-background",
      "theme-color-swap-with-repeated-content-skeleton"
    ]
  },
