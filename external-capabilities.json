{
  "external_capabilities": [
    {
      "gate": "built-in image_gen availability",
      "id": "codex-image-gen",
      "required_for": [
        "generate-image-slide",
        "slide-background-image",
        "ppt-builder"
      ],
      "vendored": false
    },
    {
      "gate": "@oai/artifact-tool ES module availability through the Codex Node runtime",
      "id": "presentations-artifact-tool",
      "required_for": [
        "ppt-builder"
      ],
      "vendored": false
    },
    {
      "gate": "RUNTIME_NODE, RUNTIME_NODE_MODULES and RUNTIME_BIN_DIR supplied by Codex load_workspace_dependencies; system Node is not an accepted substitute",
      "id": "node",
      "required_for": [
        "html-pattern-slide",
        "ppt-builder"
      ],
      "vendored": false
    },
    {
      "gate": "system-selected CPython 3.13 with PyYAML 6.0.3; Codex bundled Python is not sufficient for repository scripts",
      "id": "python",
      "required_for": [
        "all"
      ],
      "vendored": false
    },
    {
      "gate": "real local browser QA",
      "id": "browser",
      "required_for": [
        "html-pattern-slide",
        "html-image-slide",
        "slide-background-image"
      ],
      "vendored": false
    },
    {
      "gate": "Windows PowerPoint native render and OOXML verification",
      "id": "powerpoint",
      "required_for": [
        "ppt-builder"
      ],
      "vendored": false
    }
  ],
  "package": "NESA-SLIDE",
  "runtime_contract": {
    "node": {
      "required_environment": [
        "RUNTIME_NODE",
        "RUNTIME_NODE_MODULES",
        "RUNTIME_BIN_DIR"
      ],
      "selector": "Codex load_workspace_dependencies",
      "system_node_allowed": false
    },
    "python": {
      "bundled_python_sufficient": false,
      "pyyaml_version": "6.0.3",
      "selector": "NESA_PYTHON system-selected CPython 3.13"
    },
    "verification_script": "CHECK_SYSTEM.ps1"
  },
  "schema_version": 1
}
